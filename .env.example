# ==============================================================================
# Banco de dados (PostgreSQL)
# Porta 5434 — mapeada pelo Docker Compose (não usar 5432)
# ==============================================================================
POSTGRES_USER=churn_user
POSTGRES_PASSWORD=churn_pass
POSTGRES_DB=churn_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
DATABASE_URL=postgresql+psycopg2://churn_user:churn_pass@localhost:5434/churn_dev

# ==============================================================================
# Experiment tracking (MLflow)
# ==============================================================================
MLFLOW_TRACKING_URI=http://localhost:5000

# ==============================================================================
# API FastAPI — segurança e autenticação
# ==============================================================================
APP_SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=30
BCRYPT_ROUNDS=12

# ==============================================================================
# API FastAPI — cache e limites
# ==============================================================================
API_KEY_CACHE_TTL_SECONDS=60
MODEL_CACHE_TTL_SECONDS=300
MAX_BATCH_SIZE=100

# ==============================================================================
# Observabilidade
# ==============================================================================
LOG_LEVEL=INFO
APP_VERSION=1.0.0

# ==============================================================================
# Grafana (leitura do banco para dashboards)
# ==============================================================================
GRAFANA_DB_USER=grafana_user
GRAFANA_DB_PASSWORD=grafana_pass

# ==============================================================================
# Explicabilidade SHAP
# SHAP_ENABLED=true  ativa cálculo inline em /predict e /predict/batch (+5-30ms)
# SHAP_TOP_N         número de features a retornar por predição
# ==============================================================================
SHAP_ENABLED=false
SHAP_TOP_N=5

# ==============================================================================
# Tradução LLM — OpenAI
# Modelo e parâmetros são configurados por projeto em churn.project_llm_config.
# Apenas a chave de API permanece como variável de ambiente.
# ==============================================================================
OPENAI_API_KEY=sk-...

# ==============================================================================
# Criptografia de chaves LLM por projeto
# LLM_ENCRYPTION_KEY  chave mestra para pgp_sym_encrypt/decrypt das OpenAI keys
#                     por projeto em churn.project_llm_config.openai_api_key
#
# Gere uma chave segura com:
#   openssl rand -base64 32
#
# ATENÇÃO: se alterar esta chave após gravar dados no banco, as OpenAI keys
# existentes em project_llm_config não poderão mais ser descriptografadas.
# ==============================================================================
LLM_ENCRYPTION_KEY=mude-esta-chave-em-producao
