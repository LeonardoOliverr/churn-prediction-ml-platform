  "panels": [
    {
      "id": 1,
      "title": "F1 Score por Modelo (histórico de runs)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "champion"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": "PostgreSQL",
          "rawSql": "SELECT evaluated_at AS time, model_name_snapshot || ' (' || model_role_snapshot || ')' AS metric, f1_score AS value FROM churn.model_performance WHERE tenant_id = (SELECT id FROM churn.tenants WHERE slug = '${tenant}') ORDER BY 1",
          "format": "time_series"
        }
      ]
    },
