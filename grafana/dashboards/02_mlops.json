        "hide": 0,
        "includeAll": false,
        "label": "Tenant",
        "multi": false,
        "name": "tenant",
        "options": [],
        "query": "SELECT slug FROM churn.tenants ORDER BY slug",
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": "PostgreSQL",
        "definition": "SELECT slug FROM churn.projects WHERE tenant_id = (SELECT id FROM churn.tenants WHERE slug = '${tenant}') ORDER BY slug",
