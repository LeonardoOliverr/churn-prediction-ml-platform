meta {
  name: Promover challenger a champion
  type: http
  seq: 4
}

post {
  url: {{base_url}}/admin/tenants/{{tenant_id}}/projects/{{project_id}}/models/{{model_id}}/promote
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "activation_reason": "XGBoost v1 supera Random Forest em F1 (0.6667 vs 0.6437) e recall (0.80 vs 0.79) na avaliação em produção. Threshold calibrado em 0.60."
  }
}
