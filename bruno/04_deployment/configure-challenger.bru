meta {
  name: Configurar challenger
  type: http
  seq: 3
}

post {
  url: {{base_url}}/admin/tenants/{{tenant_id}}/projects/{{project_id}}/models/{{model_id}}/challenger
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "threshold": 0.45,
    "traffic_split": 0.2,
    "activation_reason": "Random Forest reativado como challenger após promoção do XGBoost a champion. Threshold calibrado em 0.45 via optimize_threshold.py.",
    "description": "Random Forest v1 challenger — referência comparativa contra XGBoost champion."
  }
}
