meta {
  name: Predição em lote
  type: http
  seq: 2
}

post {
  url: {{base_url}}/predict/batch
  body: json
  auth: none
}

headers {
  x-api-key: {{api_key}}
}

body:json {
  {
    "customers": [
      {
        "customer_id": "CUST-HIGHRISK-001",
        "tenure_months": 1,
        "monthly_charges": 99.9,
        "total_charges": 99.9,
        "senior_citizen": 0,
        "partner": 0,
        "dependents": 0,
        "phone_service": 1,
        "paperless_billing": 1,
        "gender": "Male",
        "multiple_lines": "No",
        "internet_service": "Fiber optic",
        "online_security": "No",
        "online_backup": "No",
        "device_protection": "No",
        "tech_support": "No",
        "streaming_tv": "No",
        "streaming_movies": "No",
        "contract": "Month-to-month",
        "payment_method": "Electronic check"
      },
      {
        "customer_id": "CUST-LOWRISK-002",
        "tenure_months": 72,
        "monthly_charges": 45.0,
        "total_charges": 3240.0,
        "senior_citizen": 0,
        "partner": 1,
        "dependents": 1,
        "phone_service": 1,
        "paperless_billing": 0,
        "gender": "Female",
        "multiple_lines": "Yes",
        "internet_service": "DSL",
        "online_security": "Yes",
        "online_backup": "Yes",
        "device_protection": "Yes",
        "tech_support": "Yes",
        "streaming_tv": "No",
        "streaming_movies": "No",
        "contract": "Two year",
        "payment_method": "Bank transfer (automatic)"
      }
    ]
  }
  
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("results retorna array com total correto", function() {
    expect(res.body).to.have.property("results");
    expect(res.body).to.have.property("total");
    expect(res.body.results.length).to.equal(res.body.total);
  });
  
  test("cada resultado tem campos obrigatórios", function() {
    res.body.results.forEach(function(item) {
      expect(item).to.have.property("prediction_id");
      expect(item).to.have.property("customer_id");
      expect(item).to.have.property("churn_probability");
      expect(item).to.have.property("risk_level");
      expect(item).to.have.property("explanation");
    });
  });
  
  test("explanation: dict com features quando SHAP ativo, null caso contrário", function() {
    res.body.results.forEach(function(item) {
      var explanation = item.explanation;
      if (explanation !== null) {
        expect(typeof explanation).to.equal("object");
        expect(Object.keys(explanation).length).to.be.greaterThan(0);
        Object.values(explanation).forEach(function(val) {
          expect(typeof val).to.equal("number");
        });
      }
    });
  });
}
